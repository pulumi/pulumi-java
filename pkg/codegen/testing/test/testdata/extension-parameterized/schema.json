{
  "name": "myext",
  "displayName": "My Extension",
  "description": "Extension package layered onto a base provider",
  "repository": "https://example.com",
  "version": "2.0.0",
  "meta": {
    "moduleFormat": "(.*)"
  },
  "config": {},
  "types": {
    "extbase:index:GreetingSettings": {
      "type": "object",
      "properties": {
        "volume": {
          "type": "integer",
          "description": "How loud the greeting should be."
        }
      }
    }
  },
  "resources": {
    "extbase:index:Greeting": {
      "description": "A greeting resource layered onto the base provider.",
      "properties": {
        "message": {
          "type": "string",
          "description": "The rendered greeting."
        }
      },
      "type": "object",
      "inputProperties": {
        "name": {
          "type": "string",
          "description": "Who to greet."
        },
        "settings": {
          "$ref": "#/types/extbase:index:GreetingSettings"
        }
      }
    },
    "extbase:index:GreetingComponent": {
      "description": "A greeting component layered onto the base provider.",
      "isComponent": true,
      "properties": {
        "message": {
          "type": "string",
          "description": "The rendered greeting."
        }
      },
      "type": "object",
      "inputProperties": {
        "name": {
          "type": "string",
          "description": "Who to greet."
        }
      }
    }
  },
  "functions": {
    "extbase:index:greet": {
      "description": "Renders a greeting.",
      "inputs": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "outputs": {
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "extensionParameterization": {
    "baseProvider": {
      "name": "extbase",
      "version": "45.0.0"
    },
    "parameter": "Z3JlZXRpbmdz"
  }
}
